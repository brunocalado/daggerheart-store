{
  "id": "daggerheart-store",
  "title": "Daggerheart: Store",
  "version": "0.6.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Mestre Digital",
      "url": "http://youtube.com/@mestredigital",
      "flags": {}
    }
  ],
  "description": "A dynamic, interactive, and fully configurable store for the Daggerheart system in Foundry VTT. Allow your players to purchase weapons, armor, potions, and miscellaneous items directly from an elegant visual interface, while the GM maintains full control over prices and what is displayed.",
  "relationships": {
    "systems": [
      {
        "id": "daggerheart",
        "type": "system",
        "compatibility": {}
      }
    ]
  },
  "media": [
    {
      "type": "setup",
      "url": "modules/daggerheart-store/assets/images/thumbnail.webp",
      "thumbnail": "modules/daggerheart-store/assets/images/thumbnail.webp",
      "loop": false,
      "flags": {}
    }
  ],
  "socket": true,
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": [
    {
      "src": "styles/variables.css"
    },
    {
      "src": "styles/store.css"
    },
    {
      "src": "styles/config.css"
    },
    {
      "src": "styles/welcome.css"
    },
    {
      "src": "styles/randomizer.css"
    },
    {
      "src": "styles/tooltips.css"
    },
    {
      "src": "styles/dialogs.css"
    },
    {
      "src": "styles/item-tagger.css"
    },
    {
      "src": "styles/negotiation.css"
    }
  ],
  "packs": [
    {
      "label": "General Items",
      "type": "Item",
      "name": "general-items",
      "path": "packs/general-items",
      "system": "daggerheart",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {},
      "banner": "modules/daggerheart-store/assets/images/banner.webp"
    },
    {
      "label": "Macros",
      "type": "Macro",
      "name": "macros",
      "path": "packs/macros",
      "system": "daggerheart",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {},
      "banner": "modules/daggerheart-store/assets/images/banner.webp"
    },
    {
      "label": "Journals",
      "type": "JournalEntry",
      "name": "journals",
      "path": "packs/journals",
      "system": "daggerheart",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {},
      "banner": "modules/daggerheart-store/assets/images/banner.webp"
    }
  ],
  "packFolders": [
    {
      "name": "💰 Store",
      "sorting": "a",
      "color": "#624d09",
      "packs": [
        "general-items",
        "journals",
        "macros"
      ],
      "folders": []
    }
  ],
  "url": "https://github.com/brunocalado/daggerheart-store",
  "manifest": "https://raw.githubusercontent.com/brunocalado/daggerheart-store/main/module.json",
  "download": "https://codeload.github.com/brunocalado/daggerheart-store/zip/main",
  "flags": {}
}