<form class="daggerheart-store-container">
    <header class="store-header">
        {{#if isGM}}
        <div class="header-left">
            <strong>Daggerheart Store Manager</strong>
        </div>
        <div class="header-right">
            <!-- Randomizer Button -->
            <button type="button" class="config-btn" data-action="openRandomizer" title="Store Randomizer">
                <i class="fas fa-dice"></i>
            </button>

            <span class="header-separator">|</span>

            <!-- Config Button -->
            <button type="button" class="config-btn" data-action="openConfig" title="GM Configuration">
                <i class="fas fa-cog"></i> Config
            </button>

            <span class="header-separator">|</span>

            <!-- Presets Combo & Buttons -->
            <select class="preset-select" name="storePreset">
                {{#each presets}}
                <option value="{{this}}" {{#if (eq this ../currentProfile)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>

            <button type="button" class="config-btn icon-only" data-action="savePreset" title="Save Preset">
                <i class="fas fa-save"></i>
            </button>
            
            <button type="button" class="config-btn icon-only" data-action="loadPreset" title="Load Preset">
                <i class="fas fa-folder-open"></i>
            </button>

            <button type="button" class="config-btn icon-only" data-action="deletePreset" title="Delete Selected Profile" style="color: #ff9999; border-color: #8b3333;">
                <i class="fas fa-trash"></i>
            </button>

            <span class="header-separator">|</span>

            <!-- Original: Share Buttons -->
            <button type="button" class="config-btn" data-action="showToAll" title="Show to Everyone">
                <i class="fas fa-globe"></i>
            </button>
            <button type="button" class="config-btn" data-action="showToPlayer" title="Show to Player">
                <i class="fas fa-user"></i>
            </button>
        </div>
        {{else}}
            {{#if hasPartyActor}}
                <!-- Party Actor Selected: Layout Split -->
                <div class="header-left">
                    <label>Character:</label> <strong>{{actorName}}</strong>
                </div>
                <div class="header-right">
                    <!-- NEW: Transfer Funds Button -->
                    <button type="button" class="config-btn" data-action="transferFunds" title="Transfer Funds">
                        <i class="fas fa-exchange-alt"></i> Transfer
                    </button>
                    
                    <!-- Separator -->
                    <span style="margin: 0 10px; opacity: 0.5;">|</span>

                    <!-- PC Wealth -->
                    <label>PC Wealth:</label>
                    <span class="gold-display"><i class="fas fa-coins"></i> {{userGold}} {{currency}}</span>
                    
                    <!-- Separator -->
                    <span style="margin: 0 10px; opacity: 0.5;">|</span>
                    
                    <!-- Party Wealth -->
                    <label>Party Wealth:</label>
                    <span class="gold-display"><i class="fas fa-users"></i> {{partyGold}} {{currency}}</span>
                </div>
            {{else}}
                <!-- No Party Actor: Standard Display -->
                <div class="header-left">
                    <label>Character:</label> <strong>{{actorName}}</strong>
                </div>
                <div class="header-right">
                    <label>PC Wealth:</label>
                    <span class="gold-display"><i class="fas fa-coins"></i> {{userGold}} {{currency}}</span>
                </div>
            {{/if}}
        {{/if}}
    </header>

    {{#unless isGM}}
        {{#unless hasActor}}
        <div class="error-banner">
            Warning: You have no assigned character. You cannot make purchases.
        </div>
        {{/unless}}
    {{/unless}}

    <!-- Tab Navigation -->
    <nav class="sheet-tabs tabs">
        {{#each categories}}
        <a class="item {{#if (eq this.id ../activeTab)}}active{{/if}}" data-tab="{{this.id}}">{{this.label}}</a>
        {{/each}}
    </nav>

    <!-- Content -->
    <section class="content">
        {{#each categories as |cat|}}
        <div class="tab" data-tab="{{cat.id}}" style="display: {{#if (eq cat.id ../activeTab)}}block{{else}}none{{/if}};">
            
            <div class="search-container">
                <input type="text" class="store-search" placeholder="Search..." autocomplete="off">
                {{#if ../isGM}}
                <div class="bulk-actions">
                    <button type="button" class="bulk-btn" data-action="markAllOnSale" title="Mark All as On Sale">
                        <i class="fas fa-tag"></i>
                    </button>
                    <button type="button" class="bulk-btn" data-action="removeAllFromSale" title="Remove All from Sale">
                        <i class="fas fa-tag" style="opacity: 0.4;"></i>
                    </button>
                    <span class="bulk-separator"></span>
                    <button type="button" class="bulk-btn" data-action="showAllItems" title="Show All Items">
                        <i class="fas fa-eye"></i>
                    </button>
                    <button type="button" class="bulk-btn" data-action="hideAllItems" title="Hide All Items">
                        <i class="fas fa-eye-slash"></i>
                    </button>
                    <span class="bulk-separator"></span>
                    <button type="button" class="bulk-btn" data-action="makeAllPurchasable" title="Make All Purchasable">
                        <i class="fas fa-cart-arrow-down"></i>
                    </button>
                    <button type="button" class="bulk-btn" data-action="disableAllPurchase" title="Disable Purchase for All">
                        <i class="fas fa-cart-arrow-down" style="opacity: 0.4;"></i>
                    </button>
                    <span class="bulk-separator"></span>
                    <button type="button" class="bulk-btn" data-action="makeAllSellable" title="Set All as Sellable">
                        <i class="fas fa-hand-holding-usd"></i>
                    </button>
                    <button type="button" class="bulk-btn" data-action="disableAllSale" title="Disable Sale for All">
                        <i class="fas fa-hand-holding-usd" style="opacity: 0.4;"></i>
                    </button>
                    <span class="bulk-separator"></span>
                    <button type="button" class="bulk-btn" data-action="lockAllItems" title="Lock All Items">
                        <i class="fas fa-lock"></i>
                    </button>
                    <button type="button" class="bulk-btn" data-action="unlockAllItems" title="Unlock All Items">
                        <i class="fas fa-lock-open"></i>
                    </button>
                </div>
                {{/if}}
            </div>

            {{#each (lookup ../tabs cat.id) as |group|}}
                {{#if group.label}}
                <div class="tier-separator {{#if group.isHiddenGroup}}hidden-group-separator{{/if}}">{{{group.label}}}</div>
                {{/if}}
                
                <div class="item-list">
                    {{#each group.items}}
                    <div class="store-row {{#if this.isHidden}}gm-hidden-item{{/if}} {{#if this.isSale}}sale-pulse{{/if}} {{#if this.isEpic}}epic-row epic-fx-{{this.epicEffect}}{{/if}}" {{#if this.isEpic}}style="background: {{this.epicBgColor}}; border-left-color: {{this.epicColor}};"{{/if}}>

                        <!-- Left Side: Icon, Name AND Sale Text -->
                        <div class="row-left">
                            <div class="item-icon-wrapper">
                                <img src="{{this.img}}" title="Click to view details" class="item-image" data-uuid="{{this.uuid}}" width="36" height="36"/>
                                {{#unless ../../../isGM}}
                                    {{#if this.stockEnabled}}
                                        {{#if this.stockUnlimited}}
                                            <span class="item-quantity-badge unlimited"><i class="fas fa-infinity"></i></span>
                                        {{else if this.stockQuantity}}
                                            <span class="item-quantity-badge">{{this.stockQuantity}}</span>
                                        {{else}}
                                            {{#if (eq this.stockStatus "out")}}
                                                <span class="item-quantity-badge out-of-stock"><i class="fas fa-times"></i></span>
                                            {{/if}}
                                        {{/if}}
                                    {{/if}}
                                {{/unless}}
                            </div>

                            <!-- NEW: Recommendation Crown -->
                            {{#if this.isRecommended}}
                                <i class="fas fa-crown recommended-icon" title="Recommended for your highest Trait"></i>
                            {{/if}}

                            <span class="store-item-name" {{#if this.description}}data-item-desc="{{this.description}}"{{/if}}>{{this.name}}</span>

                            {{#unless ../../../isGM}}
                                {{#if this.isSale}}
                                    <span class="sale-badge">(SALE)</span>
                                {{/if}}
                            {{/unless}}

                            <!-- Item Summary (Replaces Weapon Summary) -->
                            {{#if this.itemSummary}}
                                <span class="weapon-stats">{{this.itemSummary}}</span>
                            {{/if}}

                            {{#unless ../../../isGM}}
                                {{#if this.isEpic}}
                                    <span class="epic-badge" style="background: {{this.epicColor}}; color: {{this.epicTextColor}};">
                                        <i class="fas {{this.epicIcon}}"></i> {{this.epicLabel}}
                                    </span>
                                {{/if}}
                            {{/unless}}
                        </div>

                        <!-- Right Side: Controls -->
                        <div class="row-right">
                            {{#if ../../../isGM}}
                                <div class="gm-controls">
                                    <div class="gm-buttons">
                                        <button type="button" 
                                                data-action="toggleSale" 
                                                data-name="{{this.name}}"
                                                class="icon-btn {{#if this.isSale}}active-sale{{/if}}"
                                                title="Toggle Sale">
                                            <i class="fas fa-tag"></i>
                                        </button>
                                        
                                        <button type="button"
                                                data-action="toggleHidden"
                                                data-name="{{this.name}}"
                                                class="icon-btn {{#if this.isHidden}}active-hidden{{/if}}"
                                                title="Hide Item (Item will not appear for players)">
                                            <i class="fas fa-eye{{#if this.isHidden}}-slash{{/if}}"></i>
                                        </button>

                                        <button type="button"
                                                data-action="toggleBlockPurchase"
                                                data-name="{{this.name}}"
                                                class="icon-btn {{#if this.isPurchaseBlocked}}active-block-purchase{{/if}}"
                                                title="Block Purchase (Players cannot buy this item)">
                                            <i class="fas fa-cart-arrow-down"></i>
                                        </button>

                                        <button type="button"
                                                data-action="toggleBlockSale"
                                                data-name="{{this.name}}"
                                                class="icon-btn {{#if this.isSaleBlocked}}active-block-sale{{/if}}"
                                                title="Block Sale (Players cannot sell this item)">
                                            <i class="fas fa-hand-holding-usd"></i>
                                        </button>

                                        <button type="button"
                                                data-action="toggleLock"
                                                data-name="{{this.name}}"
                                                class="icon-btn {{#if this.isLocked}}active-locked{{/if}}"
                                                title="Lock Item (Randomizer will skip this item)">
                                            <i class="fas fa-lock{{#unless this.isLocked}}-open{{/unless}}"></i>
                                        </button>

                                        <button type="button"
                                                data-action="toggleEpic"
                                                data-name="{{this.name}}"
                                                class="icon-btn {{#if this.isEpic}}active-epic{{/if}}"
                                                title="Mark as Epic">
                                            <i class="fas {{../../../epicIcon}}"></i>
                                        </button>

                                        {{#if this.isOverridden}}
                                        <button type="button" 
                                                class="reset-price-btn" 
                                                data-action="resetPrice"
                                                data-name="{{this.name}}" 
                                                title="Reset to Default Price">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                        {{/if}}
                                    </div>

                                    <div class="gm-input-group">
                                        <span class="gm-input-label">Price</span>
                                        <input type="number"
                                               class="gm-price-input"
                                               value="{{this.price}}"
                                               data-name="{{this.name}}"
                                               min="0" step="1"
                                               title="Item Price">
                                    </div>

                                    {{#if this.stockEnabled}}
                                        <div class="gm-input-group">
                                            <span class="gm-input-label">Stock</span>
                                            <input type="number"
                                                   class="gm-stock-input"
                                                   value="{{this.stockQuantity}}"
                                                   data-uuid="{{this.uuid}}"
                                                   min="0"
                                                   max="9999"
                                                   placeholder="∞"
                                                   title="Stock Quantity (empty = unlimited)">
                                        </div>
                                    {{/if}}
                                </div>
                            {{else}}
                                <div class="player-controls">
                                    <!-- STOCK DISPLAY (Players) - Only show Out of Stock text -->
                                    {{#if this.stockEnabled}}
                                        {{#if (eq this.stockStatus "out")}}
                                            <div class="stock-display">
                                                <span class="stock-count stock-out">Out of Stock</span>
                                            </div>
                                        {{/if}}
                                    {{/if}}

                                    <div class="price-display">
                                        {{#if this.isSale}}
                                            <span class="item-price sale">
                                                <i class="fas fa-coins price-coin-icon"></i>
                                                <span class="original">{{this.originalPrice}}</span>
                                                <!-- REMOVIDO: currency -->
                                                <span class="new">{{this.price}}</span>
                                            </span>
                                        {{else}}
                                            <!-- REMOVIDO: currency -->
                                            
                                            <span class="item-price">
                                            <i class="fas fa-coins price-coin-icon"></i>
                                            {{this.price}}</span>
                                        {{/if}}
                                    </div>

                                    <!-- COMPARE BUTTON (Players Only) -->
                                    {{#if this.hasEquippedItem}}
                                        <button type="button"
                                                class="compare-btn"
                                                data-item-uuid="{{this.uuid}}"
                                                data-category="{{#if this.compareCategory}}{{this.compareCategory}}{{else}}{{../../../activeTab}}{{/if}}"
                                                title="Compare with equipped">
                                            <i class="fas fa-scale-unbalanced"></i>
                                        </button>
                                    {{/if}}

                                    <!-- SELL BUTTON (NEW) -->
                                    <button type="button"
                                            class="sell-btn"
                                            data-action="sellItem"
                                            data-name="{{this.name}}"
                                            data-uuid="{{this.uuid}}"
                                            data-price="{{this.sellPrice}}"
                                            title="Sell Item for {{this.sellPrice}}"
                                            {{#unless this.canSell}}disabled{{/unless}}>
                                        <i class="fas fa-sack-dollar"></i> Sell
                                    </button>

                                    <!-- BUY BUTTONS -->
                                    {{#if ../../../hasPartyActor}}
                                        <button type="button"
                                                class="buy-btn"
                                                data-action="buyItem"
                                                data-source="personal"
                                                data-id="{{this.id}}"
                                                data-uuid="{{this.uuid}}"
                                                data-price="{{this.price}}"
                                                data-name="{{this.name}}"
                                                title="Buy with your own funds"
                                                {{#if (or (not this.canBuyPersonal) (eq this.stockStatus "out"))}}disabled{{/if}}>
                                            <i class="fas fa-hand-holding-dollar"></i>
                                        </button>

                                        <button type="button"
                                                class="buy-btn party-btn"
                                                data-action="buyItem"
                                                data-source="party"
                                                data-id="{{this.id}}"
                                                data-uuid="{{this.uuid}}"
                                                data-price="{{this.price}}"
                                                data-name="{{this.name}}"
                                                title="Split Payment with Party Funds"
                                                {{#if (or (not this.canBuyParty) (eq this.stockStatus "out"))}}disabled{{/if}}>
                                            <i class="fas fa-users"></i>
                                        </button>
                                    {{else}}
                                        <button type="button"
                                                class="buy-btn"
                                                data-action="buyItem"
                                                data-source="personal"
                                                data-id="{{this.id}}"
                                                data-uuid="{{this.uuid}}"
                                                data-price="{{this.price}}"
                                                data-name="{{this.name}}"
                                                {{#if (or (not this.canBuyPersonal) (eq this.stockStatus "out"))}}disabled{{/if}}>
                                            <i class="fas fa-hand-holding-dollar"></i> Buy
                                        </button>
                                    {{/if}}
                                </div>
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            {{else}}
                <p class="empty-tab">No items available in this category based on current GM settings.</p>
            {{/each}}
        </div>
        {{/each}}
    </section>
</form>