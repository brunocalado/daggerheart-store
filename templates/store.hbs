<form class="daggerheart-store-container">
    {{> "modules/daggerheart-store/templates/partials/store-header.hbs"}}

    {{#unless isGM}}
        {{#unless hasActor}}
        <div class="error-banner">
            Warning: You have no assigned character. You cannot make purchases.
        </div>
        {{/unless}}
    {{/unless}}

    <!-- Tab Navigation -->
    <nav class="sheet-tabs tabs">
        {{#each categories}}
        <a class="item {{#if this.iconOnly}}icon-only{{/if}} {{#if (eq this.id ../activeTab)}}active{{/if}}"
           data-tab="{{this.id}}"
           title="{{this.label}}">
            {{#if this.iconOnly}}
                <i class="fas {{this.icon}}"></i>
            {{else}}
                {{this.label}}
            {{/if}}
        </a>
        {{/each}}
    </nav>

    <!-- Content -->
    <section class="content">
        {{#each categories as |cat|}}
        <div class="tab" data-tab="{{cat.id}}" style="display: {{#if (eq cat.id ../activeTab)}}block{{else}}none{{/if}};">

            {{#if (eq cat.id "sell")}}
                {{> "modules/daggerheart-store/templates/partials/store-sell-tab.hbs"}}
            {{else}}
                {{> "modules/daggerheart-store/templates/partials/store-search-bar.hbs"}}

                {{#each (lookup ../tabs cat.id) as |group|}}
                    {{#if group.label}}
                    <div class="tier-separator {{#if group.isHiddenGroup}}hidden-group-separator{{/if}}">{{{group.label}}}</div>
                    {{/if}}

                    <div class="item-list">
                        {{#each group.items}}
                        {{> "modules/daggerheart-store/templates/partials/store-item-row.hbs"}}
                        {{/each}}
                    </div>
                {{else}}
                    <p class="empty-tab">No items available in this category based on current GM settings.</p>
                {{/each}}
            {{/if}}
        </div>
        {{/each}}
    </section>
</form>