<div class="store-tagger-container">
    {{#if hasFolderItems}}
        {{!-- Folder batch mode: checklist + shared tag form --}}
        <div class="folder-header">
            <span><i class="fas fa-folder-open"></i> {{folderItems.length}} item(s) loaded</span>
            <button type="button" class="clear-btn" data-action="clearFolder">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="folder-item-list">
            {{#each folderItems}}
                <div class="folder-item-row">
                    <label class="item-check-area">
                        <input type="checkbox" data-uuid="{{this.uuid}}" checked>
                        <img src="{{this.img}}" class="item-thumb" />
                        <span class="item-name">{{this.name}}</span>
                        <span class="item-type">{{this.type}}</span>
                    </label>
                    <button type="button" class="view-item-btn" data-uuid="{{this.uuid}}" title="Open item sheet">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            {{/each}}
        </div>

        <div class="tag-inputs">
            <div class="form-group">
                <label><i class="fas fa-coins"></i> Price</label>
                <input type="number" name="price" placeholder="e.g. 50" min="0" step="1">
                <p class="hint">Leave blank to clear the price flag on all checked items.</p>
            </div>

            <div class="form-group">
                <label><i class="fas fa-layer-group"></i> Tier</label>
                {{!-- Batch tier: "" = leave unchanged, "none" = clear flag (non-weapon/armor only), "1-4" = set value. --}}
                <select name="tier">
                    <option value="">Leave unchanged</option>
                    <option value="none">None (clear)</option>
                    <option value="1">Tier 1 (Common)</option>
                    <option value="2">Tier 2 (Uncommon)</option>
                    <option value="3">Tier 3 (Rare)</option>
                    <option value="4">Tier 4 (Legendary)</option>
                </select>
                <p class="hint">"None (clear)" removes the tier flag from consumables/loot. Weapon/Armor <code>system.tier</code> is never cleared — select a tier value to change it.</p>
            </div>

            <div class="form-group">
                <label><i class="fas fa-heading"></i> Header</label>
                <input type="text" name="header" placeholder="e.g. Potions" maxlength="60">
                <p class="hint">Leave blank to clear the header flag on all checked items.</p>
            </div>
        </div>

        <div class="actions">
            <button type="button" class="save-btn" data-action="saveTags">
                <i class="fas fa-save"></i> Save to Checked Items
            </button>
        </div>

    {{else if hasItem}}
        {{!-- Single-item mode --}}
        <div class="item-preview">
            <img src="{{item.img}}" class="item-image" />
            <div class="item-name">{{item.name}}</div>
            <button type="button" class="clear-btn" data-action="clearItem"><i class="fas fa-times"></i></button>
        </div>

        <div class="tag-inputs">
            <div class="form-group">
                <label><i class="fas fa-coins"></i> Price</label>
                <input type="number" name="price" value="{{tags.price}}" placeholder="e.g. 50" min="0" step="1">
                <p class="hint"><code class="preview-price">{{#if tags.price}}Price: {{tags.price}}{{else}}(not set){{/if}}</code></p>
            </div>

            <div class="form-group">
                <label><i class="fas fa-layer-group"></i> Tier</label>
                {{#if isSystemTierType}}
                    {{!-- For weapon/armor, tier is a system field — editable but sourced from system.tier --}}
                    <select name="tier">
                        <option value="1" {{#if (eq tags.tier 1)}}selected{{/if}}>Tier 1 (Common)</option>
                        <option value="2" {{#if (eq tags.tier 2)}}selected{{/if}}>Tier 2 (Uncommon)</option>
                        <option value="3" {{#if (eq tags.tier 3)}}selected{{/if}}>Tier 3 (Rare)</option>
                        <option value="4" {{#if (eq tags.tier 4)}}selected{{/if}}>Tier 4 (Legendary)</option>
                    </select>
                    <p class="hint"><em>Reads and writes <code>system.tier</code> (not a flag).</em></p>
                {{else}}
                    <select name="tier">
                        <option value="">None</option>
                        <option value="1" {{#if (eq tags.tier 1)}}selected{{/if}}>Tier 1 (Common)</option>
                        <option value="2" {{#if (eq tags.tier 2)}}selected{{/if}}>Tier 2 (Uncommon)</option>
                        <option value="3" {{#if (eq tags.tier 3)}}selected{{/if}}>Tier 3 (Rare)</option>
                        <option value="4" {{#if (eq tags.tier 4)}}selected{{/if}}>Tier 4 (Legendary)</option>
                    </select>
                    <p class="hint"><code class="preview-tier">{{#if tags.tier}}Tier: {{tags.tier}}{{else}}(not set){{/if}}</code></p>
                {{/if}}
            </div>

            <div class="form-group">
                <label><i class="fas fa-heading"></i> Header</label>
                <input type="text" name="header" value="{{tags.header}}" placeholder="e.g. Potions" maxlength="60">
                <p class="hint"><code class="preview-header">{{#if tags.header}}Header: {{tags.header}}{{else}}(not set){{/if}}</code></p>
            </div>
        </div>

        <div class="actions">
            <button type="button" class="save-btn" data-action="saveTags">
                <i class="fas fa-save"></i> Save Item Flags
            </button>
        </div>

    {{else}}
        {{!-- Empty state: drop zone accepts both items and folders --}}
        <div class="drop-zone">
            <i class="fas fa-cloud-download-alt"></i>
            <p>Drag and drop an <strong>Item</strong> or <strong>Folder</strong> here to set store metadata.</p>
        </div>
    {{/if}}
</div>
