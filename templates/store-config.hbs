<div class="daggerheart-store-config">
    <!-- Config Tabs -->
    <nav class="sheet-tabs tabs">
        <a class="item {{#if (eq activeTab 'general')}}active{{/if}}" data-tab="general"><i class="fas fa-cogs"></i> General</a>
        <a class="item {{#if (eq activeTab 'categories')}}active{{/if}}" data-tab="categories"><i class="fas fa-eye"></i> Categories</a>
        <a class="item {{#if (eq activeTab 'tiers')}}active{{/if}}" data-tab="tiers"><i class="fas fa-layer-group"></i> Tiers</a>
        <a class="item {{#if (eq activeTab 'compendiums')}}active{{/if}}" data-tab="compendiums"><i class="fas fa-book"></i> Custom Compendiums</a>
        <a class="item {{#if (eq activeTab 'stock')}}active{{/if}}" data-tab="stock"><i class="fas fa-boxes"></i> Stock Management</a>
    </nav>

    <!-- Tab: General -->
    <div class="tab-content {{#if (eq activeTab 'general')}}active{{/if}}" data-tab="general">

        <div class="form-group inline-group">
            <label>Store Window Name</label>
            <input type="text" name="storeName" value="{{storeName}}">
            <p class="notes">Sets the title of the main store window.</p>
        </div>

        <hr>

        <div class="form-group inline-group">
            <label>Party Actor</label>
            <select name="partyActorId">
                <option value="">None</option>
                {{#each partyActors}}
                <option value="{{this.id}}" {{#if (eq this.id ../selectedPartyActor)}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>
            <span class="ownership-info" {{#unless selectedPartyActor}}style="display: none;"{{/unless}}>
                <span class="config-separator">|</span>
                <span class="ownership-label">Ownership:</span>
                <span class="ownership-value">{{partyActorOwnership}}</span>
                <span class="config-separator">|</span>
                <span class="ownership-status {{#if partyActorOwnershipOk}}status-ok{{else}}status-warning{{/if}}">
                    Status: {{#if partyActorOwnershipOk}}OK{{else}}WARNING (Read Docs){{/if}}
                </span>
            </span>
        </div>
        <p class="notes">Select a party actor to enable shared wealth, stock management, and randomizer features.</p>

        <hr>

        <h3 style="margin-top: 5px;">Epic Items</h3>

        <div class="form-group inline-group">
            <label>Label</label>
            <input type="text" name="epicLabel" value="{{epicLabel}}" placeholder="Epic" maxlength="15">
            <p class="notes">Custom label displayed on epic items (max 15 characters).</p>
        </div>

        <div class="form-group inline-group">
            <label>Icon</label>
            <select name="epicIcon">
                <option value="fa-star" {{#if (eq epicIcon 'fa-star')}}selected{{/if}}>Star</option>
                <option value="fa-gem" {{#if (eq epicIcon 'fa-gem')}}selected{{/if}}>Gem</option>
                <option value="fa-dragon" {{#if (eq epicIcon 'fa-dragon')}}selected{{/if}}>Dragon</option>
                <option value="fa-trophy" {{#if (eq epicIcon 'fa-trophy')}}selected{{/if}}>Trophy</option>
                <option value="fa-fire" {{#if (eq epicIcon 'fa-fire')}}selected{{/if}}>Fire</option>
                <option value="fa-bolt" {{#if (eq epicIcon 'fa-bolt')}}selected{{/if}}>Bolt</option>
                <option value="fa-shield-halved" {{#if (eq epicIcon 'fa-shield-halved')}}selected{{/if}}>Shield</option>
            </select>
            <p class="notes">FontAwesome icon displayed alongside epic items.</p>
        </div>

        <div class="form-group inline-group">
            <label>Color</label>
            <select name="epicColor">
                <option value="#9b59b6" {{#if (eq epicColor '#9b59b6')}}selected{{/if}}>Purple</option>
                <option value="#f39c12" {{#if (eq epicColor '#f39c12')}}selected{{/if}}>Gold</option>
                <option value="#e67e22" {{#if (eq epicColor '#e67e22')}}selected{{/if}}>Orange</option>
                <option value="#e74c3c" {{#if (eq epicColor '#e74c3c')}}selected{{/if}}>Red</option>
                <option value="#3498db" {{#if (eq epicColor '#3498db')}}selected{{/if}}>Blue</option>
                <option value="#1abc9c" {{#if (eq epicColor '#1abc9c')}}selected{{/if}}>Teal</option>
                <option value="#2ecc71" {{#if (eq epicColor '#2ecc71')}}selected{{/if}}>Green</option>
                <option value="#e91e63" {{#if (eq epicColor '#e91e63')}}selected{{/if}}>Pink</option>
            </select>
            <p class="notes">Color used for the epic badge tag and subtle row highlight.</p>
        </div>

        <div class="form-group inline-group">
            <label>Effect</label>
            <select name="epicEffect">
                <option value="none" {{#if (eq epicEffect 'none')}}selected{{/if}}>None</option>
                <option value="shine" {{#if (eq epicEffect 'shine')}}selected{{/if}}>Shine - Light</option>
                <option value="glow" {{#if (eq epicEffect 'glow')}}selected{{/if}}>Shine - Strong</option>
                <option value="pulse" {{#if (eq epicEffect 'pulse')}}selected{{/if}}>Pulse</option>
                <option value="wave" {{#if (eq epicEffect 'wave')}}selected{{/if}}>Wave</option>
                <option value="border-glow" {{#if (eq epicEffect 'border-glow')}}selected{{/if}}>Border Glow</option>
            </select>
            <p class="notes">Visual effect applied to epic item rows.</p>
        </div>

        <hr>

        <h3 style="margin-top: 5px;">Price Modifiers</h3>

        <!-- Global Price Multiplier Slider (Updated) -->
        <div class="form-group">
            <label>Global Price Multiplier</label>
            <div class="form-fields">
                <input type="range" name="priceModifier" value="{{priceModifier}}" min="50" max="300" step="1">
                <span class="range-value">{{priceModifier}}%</span>
            </div>
            <p class="notes">Adjusts all prices globally (50% to 300%). 100% = Normal.</p>
        </div>

        <!-- Sale Discount Slider -->
        <div class="form-group">
            <label>Sale Discount</label>
            <div class="form-fields">
                <input type="range" name="saleDiscount" value="{{saleDiscount}}" min="0" max="100" step="1">
                <span class="range-value">{{saleDiscount}}%</span>
            </div>
            <p class="notes">Percentage off for items marked as "On Sale".</p>
        </div>

        <!-- Sell Ratio Slider -->
        <div class="form-group">
            <label>Sell Ratio</label>
            <div class="form-fields">
                <!-- Using a computed percentage value here for the slider (0-100) -->
                <input type="range" name="sellRatioPercent" value="{{sellRatioPercent}}" min="0" max="100" step="1">
                <span class="range-value">{{sellRatioPercent}}%</span>
            </div>
            <p class="notes">Percentage of the item's value returned when selling (e.g., 50%).</p>
        </div>
    </div>

    <!-- Tab: Categories (Visibility Only) -->
    <div class="tab-content {{#if (eq activeTab 'categories')}}active{{/if}}" data-tab="categories">
        <p class="notes">Toggle to show or hide categories in the store.</p>

        <div class="category-grid">
            {{#each categories}}
            <label class="category-card {{#if this.isVisible}}active{{/if}}">
                <input type="checkbox" name="visibility.{{this.key}}" {{checked this.isVisible}}>
                <div class="card-content">
                    <i class="fas {{this.icon}} category-icon"></i>
                    <span class="category-name">{{this.label}}</span>
                </div>
                <div class="toggle-switch">
                    <div class="toggle-track"></div>
                    <div class="toggle-thumb"></div>
                </div>
            </label>
            {{/each}}
        </div>
    </div>

    <!-- Tab: Tiers (Matrix Layout) -->
    <div class="tab-content {{#if (eq activeTab 'tiers')}}active{{/if}}" data-tab="tiers">
        <p class="notes">Configure which tiers are available for each category. Click column headers to toggle all.</p>

        <div class="tiers-matrix-container">
            <table class="tiers-matrix">
                <thead>
                    <tr>
                        <th class="category-col">Category</th>
                        <!-- Headers with Master Checkboxes -->
                        <th class="tier-col tier-1-header">
                            <div class="th-content">
                                <span>Tier 1</span>
                                <input type="checkbox" class="bulk-col-toggle" data-tier="1" title="Toggle All Tier 1">
                            </div>
                        </th>
                        <th class="tier-col tier-2-header">
                            <div class="th-content">
                                <span>Tier 2</span>
                                <input type="checkbox" class="bulk-col-toggle" data-tier="2" title="Toggle All Tier 2">
                            </div>
                        </th>
                        <th class="tier-col tier-3-header">
                            <div class="th-content">
                                <span>Tier 3</span>
                                <input type="checkbox" class="bulk-col-toggle" data-tier="3" title="Toggle All Tier 3">
                            </div>
                        </th>
                        <th class="tier-col tier-4-header">
                            <div class="th-content">
                                <span>Tier 4</span>
                                <input type="checkbox" class="bulk-col-toggle" data-tier="4" title="Toggle All Tier 4">
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {{#each categories}}
                    {{#if (ne this.key "CustomTab")}}
                    <tr>
                        <!-- Row Label with Master Checkbox -->
                        <td class="category-cell">
                            <label class="row-label">
                                <input type="checkbox" class="bulk-row-toggle" data-category="{{this.key}}" title="Toggle All Tiers for {{this.label}}">
                                <i class="fas {{this.icon}}"></i> {{this.label}}
                            </label>
                        </td>

                        <!-- Tier 1 Button (Gray) -->
                        <td class="tier-cell">
                            <label class="tier-btn t1 {{#if (lookup this.tiers '1')}}active{{/if}}">
                                <input type="checkbox" name="tiers.{{this.key}}.1" {{checked (lookup this.tiers "1")}}>
                                <span>I</span>
                            </label>
                        </td>

                        <!-- Tier 2 Button (Green) -->
                        <td class="tier-cell">
                            <label class="tier-btn t2 {{#if (lookup this.tiers '2')}}active{{/if}}">
                                <input type="checkbox" name="tiers.{{this.key}}.2" {{checked (lookup this.tiers "2")}}>
                                <span>II</span>
                            </label>
                        </td>

                        <!-- Tier 3 Button (Blue) -->
                        <td class="tier-cell">
                            <label class="tier-btn t3 {{#if (lookup this.tiers '3')}}active{{/if}}">
                                <input type="checkbox" name="tiers.{{this.key}}.3" {{checked (lookup this.tiers "3")}}>
                                <span>III</span>
                            </label>
                        </td>

                        <!-- Tier 4 Button (Purple) -->
                        <td class="tier-cell">
                            <label class="tier-btn t4 {{#if (lookup this.tiers '4')}}active{{/if}}">
                                <input type="checkbox" name="tiers.{{this.key}}.4" {{checked (lookup this.tiers "4")}}>
                                <span>IV</span>
                            </label>
                        </td>
                    </tr>
                    {{/if}}
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab: Custom Compendiums -->
    <div class="tab-content {{#if (eq activeTab 'compendiums')}}active{{/if}}" data-tab="compendiums">
        
        <h3 style="margin-top:0;">Custom Tab Configuration</h3>
        <p class="notes">Create a special tab (e.g., "Merchant" or "Magic Items") linked to one or more compendiums.</p>

        <div class="form-group">
            <label>Custom Tab Name</label>
            <input type="text" name="customTabName" value="{{customTabName}}" placeholder="General">
        </div>

        <label class="stock-toggle-card {{#if customTabTierGroup}}active{{/if}}" style="margin-top: 10px;">
            <input type="checkbox" name="customTabTierGroup" {{checked customTabTierGroup}}>
            <div class="card-content">
                <i class="fas fa-layer-group stock-icon"></i>
                <div class="stock-text">
                    <strong>Group Items by Tier</strong>
                    <span class="stock-description">
                        Items with a tier field will be grouped into Tier 1 / Common, Tier 2 / Uncommon, etc.
                    </span>
                </div>
            </div>
            <div class="toggle-switch">
                <div class="toggle-track"></div>
                <div class="toggle-thumb"></div>
            </div>
        </label>

        <p class="notes" style="margin-top: 10px;">Select compendiums to display in the custom tab.</p>
        <button type="button" data-action="addCustomTabCompendium" class="add-compendium" style="margin: 10px 0;"><i class="fas fa-plus"></i> Add Compendium</button>

        <div class="custom-tab-compendiums-list">
            {{#each customTabCompendiums}}
            <div class="compendium-row form-group" style="display:flex; gap:10px; align-items:center; margin-bottom:5px;">
                <select name="customTabCompendiums.{{@index}}" style="flex:2">
                    <option value="">-- Select Compendium --</option>
                    {{#each ../availablePacks}}
                    <option value="{{this.id}}" {{#if (eq this.id ..)}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
                <button type="button"
                        data-action="removeCustomTabCompendium"
                        data-index="{{@index}}"
                        style="width: 30px; height: 30px; color: red;">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
            {{/each}}
        </div>

        <hr style="border-top: 1px solid #444; margin: 15px 0;">

        <h3>Merged Compendiums</h3>
        <p class="notes">Add additional compendiums to be merged into the standard categories (e.g. Loot, Weapons).</p>
        <button type="button" data-action="addCompendium" class="add-compendium" style="margin: 10px 0;"><i class="fas fa-plus"></i> Add Compendium</button>

        <div class="compendiums-list">
            {{#each customCompendiums}}
            <div class="compendium-row form-group" style="display:flex; gap:10px; align-items:center; margin-bottom:5px;">
                <select name="customCompendiums.{{@index}}.pack" style="flex:2">
                    <option value="">Select a Compendium...</option>
                    {{#each ../availablePacks}}
                    <option value="{{this.id}}" {{#if (eq this.id ../pack)}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select>
                <select name="customCompendiums.{{@index}}.category" style="flex:1">
                    {{#each ../availableCategories}}
                    <option value="{{this}}" {{#if (eq this ../category)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
                <button type="button"
                        data-action="removeCompendium"
                        data-index="{{@index}}"
                        style="width: 30px; height: 30px; color: red;">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- Tab: Stock Management -->
    <div class="tab-content {{#if (eq activeTab 'stock')}}active{{/if}}" data-tab="stock">

        <label class="stock-toggle-card {{#if stockEnabled}}active{{/if}} {{#unless stockReady}}disabled{{/unless}}">
            <input type="checkbox" id="stockEnabledCheckbox" name="stockEnabled" {{checked stockEnabled}} {{#unless stockReady}}disabled{{/unless}}>
            <div class="card-content">
                <i class="fas fa-boxes stock-icon"></i>
                <div class="stock-text">
                    <strong>Enable Limited Stock System</strong>
                    <span class="stock-description">
                        {{#if stockReady}}
                            Tracks item quantities and prevents purchases when out of stock.
                        {{else}}
                            <em class="warning">Requires Party Actor with Owner permission.</em>
                        {{/if}}
                    </span>
                </div>
            </div>
            <div class="toggle-switch">
                <div class="toggle-track"></div>
                <div class="toggle-thumb"></div>
            </div>
        </label>

        <h3 style="margin-top: 5px;">Quick Stock Configuration</h3>
        <p class="notes" style="margin-bottom: 8px;">Set default quantities per category and tier.</p>

        <!-- Stock Table -->
        <div class="stock-table-container" style="overflow-x: auto;">
            <table class="stock-config-table" style="width: 100%; border-collapse: collapse; background: rgba(0,0,0,0.2); border-radius: 4px;">
                <thead>
                    <tr style="background: rgba(212, 175, 55, 0.2);">
                        <th style="padding: 6px 10px; text-align: left; border-bottom: 1px solid #444; color: #d4af37; min-width: 130px;">Category</th>
                        <th style="padding: 6px 8px; text-align: center; border-bottom: 1px solid #444; color: #d4af37; width: 60px;">Tier 1</th>
                        <th style="padding: 6px 8px; text-align: center; border-bottom: 1px solid #444; color: #d4af37; width: 60px;">Tier 2</th>
                        <th style="padding: 6px 8px; text-align: center; border-bottom: 1px solid #444; color: #d4af37; width: 60px;">Tier 3</th>
                        <th style="padding: 6px 8px; text-align: center; border-bottom: 1px solid #444; color: #d4af37; width: 60px;">Tier 4</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each stockCategoryDefaults}}
                    <tr style="border-bottom: 1px solid #333;">
                        <td style="padding: 4px 10px; color: #ccc;">{{this.label}}</td>
                        <td style="padding: 3px;">
                            <input type="number" name="stockDefaults.{{this.key}}.tier1" value="{{this.tier1}}" min="0" class="stock-tier-input">
                        </td>
                        <td style="padding: 3px;">
                            <input type="number" name="stockDefaults.{{this.key}}.tier2" value="{{this.tier2}}" min="0" class="stock-tier-input">
                        </td>
                        <td style="padding: 3px;">
                            <input type="number" name="stockDefaults.{{this.key}}.tier3" value="{{this.tier3}}" min="0" class="stock-tier-input">
                        </td>
                        <td style="padding: 3px;">
                            <input type="number" name="stockDefaults.{{this.key}}.tier4" value="{{this.tier4}}" min="0" class="stock-tier-input">
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <h3 style="margin-top: 15px;">Stock Actions</h3>
        <div class="stock-actions" style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="notes" style="margin: 0; flex: 1;">Set stock quantities based on the table above:</span>
                <button type="button" data-action="applyStockDefaults" class="config-btn">
                    <i class="fas fa-magic"></i> Apply Defaults
                </button>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="notes" style="margin: 0; flex: 1;">Reset all items to their default stock quantities:</span>
                <button type="button" data-action="restockAll" class="config-btn">
                    <i class="fas fa-redo"></i> Restock All
                </button>
            </div>
        </div>

    </div>

    <!-- UPDATED FOOTER WITH INSTRUCTIONS BUTTON -->
    <footer class="sheet-footer config-footer">
        <!-- Instructions Button -->
        <button type="button" data-action="openInstructions" class="config-btn-secondary">
            <i class="fas fa-book-open"></i> Instructions
        </button>

        <!-- Save Button -->
        <button type="submit" class="config-btn-primary">
            <i class="fas fa-save"></i> Save Settings
        </button>
    </footer>
</div>