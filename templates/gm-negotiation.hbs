<div class="neg-container">

    {{! ── Title: who wants to do what ─────────────────── }}
    <h2 class="neg-title">
        {{playerName}} wants to {{#if (eq type "sell")}}sell{{else}}buy{{/if}}
        {{#if (eq itemSource "party")}}<span class="neg-source-tag">(Party Inventory)</span>{{/if}}
    </h2>

    {{! ── Item header: icon + name + listed price ─────── }}
    <div class="neg-item-header">
        <div class="neg-item-row">
            <img src="{{itemImg}}" class="neg-item-icon" data-action="viewItem" data-uuid="{{itemUuid}}"
                 title="Click to view item" width="36" height="36">
            <span class="neg-item-name">{{itemName}}</span>
        </div>
        <span class="neg-base-price">Listed: <strong>{{basePrice}} {{currency}}</strong></span>
    </div>

    {{! ── Stage: initial offer from player ───────────── }}
    {{#if isPendingGm}}
        <div class="neg-action-row">
            <div class="neg-action-left">
                <span class="neg-label">Player's Offer</span>
                <span class="neg-offer-display accent">{{playerOffer}} {{currency}}</span>
            </div>
            <button type="button" class="neg-btn accept compact" data-action="accept">
                <i class="fas fa-check"></i> Accept
            </button>
        </div>

        <div class="neg-section-label">— or send a counter-offer —</div>

        <div class="neg-action-row">
            <div class="neg-action-left">
                <label class="neg-label" for="counterOffer">Counter-Offer</label>
                <div class="neg-input-wrapper">
                    <input type="number" name="counterOffer" id="counterOffer" class="neg-input"
                           min="1" step="1"
                           value="{{basePrice}}"
                           placeholder="Your counter-offer">
                    <span class="neg-input-suffix">{{currency}}</span>
                </div>
            </div>
            <button type="button" class="neg-btn counter compact" data-action="counter">
                <i class="fas fa-exchange-alt"></i> Send Counter
            </button>
        </div>
    {{/if}}

    {{! ── Stage: player submitted final offer ────────── }}
    {{#if isPendingGmFinal}}
        {{#if gmCounter}}
            <div class="neg-offer-row">
                <span class="neg-label">Your Counter</span>
                <span class="neg-offer-display dim">{{gmCounter}} {{currency}}</span>
            </div>
            <div class="neg-divider"><i class="fas fa-arrows-alt-v"></i></div>
        {{/if}}

        <div class="neg-offer-row highlight">
            <span class="neg-label">Player's Final Offer</span>
            <span class="neg-offer-display accent">{{playerOffer}} {{currency}}</span>
        </div>

        <div class="neg-section-label">This is the player's final offer. Accept or reject.</div>

        <div class="neg-actions">
            <button type="button" class="neg-btn accept" data-action="accept">
                <i class="fas fa-check"></i> Accept
            </button>
            <button type="button" class="neg-btn reject" data-action="reject">
                <i class="fas fa-times"></i> Reject
            </button>
        </div>
    {{/if}}

    {{! ── Stage: accepted, waiting for purchase execution }}
    {{#unless isPendingGm}}{{#unless isPendingGmFinal}}
        <div class="neg-waiting">
            <i class="fas fa-spinner fa-spin neg-waiting-icon"></i>
            <span>Processing…</span>
        </div>
    {{/unless}}{{/unless}}

</div>
