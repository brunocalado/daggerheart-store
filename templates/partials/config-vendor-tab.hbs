{{! Vendor Identity }}
<div class="config-section">
    <h3><i class="fas fa-id-card"></i> Vendor Identity</h3>
    <div class="vendor-identity-form">
        <label>Store Name</label>
        <input type="text" name="storeName" value="{{storeName}}" maxlength="50">
        <span class="field-hint">Title of the main store window.</span>

        <label>Vendor Name <span class="optional">(optional)</span></label>
        <input type="text" name="vendorName" value="{{vendorName}}"
               placeholder="e.g. Garrick the Blacksmith" maxlength="30">
        <span class="field-hint">NPC name shown in the store header.</span>

        <label>Vendor Description <span class="optional">(optional)</span></label>
        <textarea name="vendorDescription" class="vendor-description-field"
                  placeholder="Brief description of this vendor..."
                  maxlength="1000">{{vendorDescription}}</textarea>
        <span class="field-hint">Flavor text shown below the vendor name.</span>

        <label>Vendor Image <span class="optional">(optional)</span></label>
        <div class="vendor-image-picker-row">
            {{#if vendorImage}}
            <img class="vendor-image-preview" src="{{vendorImage}}" alt="Vendor Image">
            {{/if}}
            <input type="text"
                   name="vendorImage"
                   class="vendor-image-path"
                   value="{{vendorImage}}"
                   placeholder="path/to/image.webp">
            <button type="button"
                    class="config-btn icon-only vendor-image-browse"
                    title="Browse for image">
                <i class="fas fa-file-image"></i>
            </button>
            {{#if vendorImage}}
            <button type="button"
                    class="config-btn icon-only vendor-image-clear"
                    title="Clear image"
                    style="color:#ff9999;">
                <i class="fas fa-times"></i>
            </button>
            {{/if}}
        </div>
        <span class="field-hint">Square 1:1 image shown next to the vendor name.</span>
    </div>
</div>

<hr>

{{! Relationship Modifiers }}
<div class="config-section">
    <h3><i class="fas fa-heart"></i> Relationship Modifiers</h3>
    <p class="notes">Define the price modifier (%) for each relationship level.
       Hostile/Distrustful increase prices; Friendly/Allied decrease them.</p>

    <table class="vendor-relation-table">
        <thead>
            <tr>
                <th>Label</th>
                <th>Price Effect</th>
                <th>Modifier %</th>
            </tr>
        </thead>
        <tbody>
            {{#each vendorRelationLevelsArray}}
            <tr class="{{#if (eq direction "up")}}modifier-row-up{{else if (eq direction "down")}}modifier-row-down{{else}}modifier-row-neutral{{/if}}">
                <td class="modifier-label-cell">{{label}}</td>
                <td class="modifier-effect-cell">
                    {{#if (eq direction "up")}}
                        <span class="effect-up"><i class="fas fa-arrow-up"></i> Higher</span>
                    {{else if (eq direction "down")}}
                        <span class="effect-down"><i class="fas fa-arrow-down"></i> Lower</span>
                    {{else}}
                        <span class="effect-neutral">—</span>
                    {{/if}}
                </td>
                <td class="modifier-input-cell">
                    {{#if (eq level 0)}}
                        <span class="modifier-fixed">No price change</span>
                        <input type="hidden" name="vendorRelationLevels.0" value="0">
                    {{else}}
                        <div class="modifier-input-wrapper">
                            <input type="number"
                                   class="vendor-relation-pct-input"
                                   name="vendorRelationLevels.{{level}}"
                                   data-level="{{level}}"
                                   value="{{pct}}"
                                   min="0" max="100" step="5">
                            <span class="modifier-pct-suffix">%</span>
                        </div>
                    {{/if}}
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>

<hr>

{{! Presence Modifier }}
<div class="config-section">
    <h3><i class="fas fa-star"></i> Presence Modifier</h3>
    <p class="notes">When enabled, each character's Presence trait value adjusts prices.
       Positive Presence grants a discount; negative Presence adds a surcharge.<br>
       Example with 1.5%/pt — Presence +3 = 4.5% discount; Presence −2 = 3.0% surcharge.</p>

    <label id="presenceEnabledCard"
           class="stock-toggle-card {{#if vendorPresenceEnabled}}active{{/if}}">
        <input type="checkbox" name="vendorPresenceEnabled" {{checked vendorPresenceEnabled}}>
        <div class="card-content">
            <i class="fas fa-star stock-icon"></i>
            <div class="stock-text">
                <strong>Enable Presence Modifier</strong>
                <span class="stock-description">Adjusts prices based on each character's Presence trait value.</span>
            </div>
        </div>
        <div class="toggle-switch">
            <div class="toggle-track"></div>
            <div class="toggle-thumb"></div>
        </div>
    </label>

    <div class="presence-modifier-row">
        <label class="presence-modifier-label">% per Presence point</label>
        <div class="modifier-input-wrapper">
            <input type="number"
                   id="presenceModifierInput"
                   name="vendorPresenceModifier"
                   class="vendor-relation-pct-input{{#unless vendorPresenceEnabled}} presence-input-inactive{{/unless}}"
                   value="{{vendorPresenceModifier}}"
                   min="0" max="20" step="0.5">
            <span class="modifier-pct-suffix">%</span>
        </div>
        <span class="field-hint">e.g. 1.5% → Presence +3 = 4.5% discount</span>
    </div>
</div>

<hr>

{{! Character Relationships }}
<div class="config-section">
    <h3><i class="fas fa-users"></i> Character Relationships</h3>
    {{#if linkedActors}}
    <p class="notes">Only characters linked to a user account are listed.
       Relationship is stored per actor and persists across user reassignments.</p>

    <div class="vendor-relations-header {{#if vendorPresenceEnabled}}has-presence{{/if}}">
        <span class="vr-col-char">Character</span>
        <span class="vr-col-status">Status</span>
        <span class="vr-col-rel">Rel. Bonus</span>
        {{#if vendorPresenceEnabled}}
        <span class="vr-col-presence">Presence</span>
        <span class="vr-col-total">Total</span>
        {{/if}}
    </div>

    <div class="vendor-relations-list">
        {{#each linkedActors}}
        <div class="vendor-relation-row {{#if ../vendorPresenceEnabled}}has-presence{{/if}}"
             data-presence-pct="{{presencePctRaw}}">
            <div class="vr-col-char">
                <img class="vendor-actor-icon" src="{{img}}" title="{{name}}">
                <span class="vendor-actor-name">{{name}}</span>
            </div>
            <div class="vr-col-status">
                <select name="vendorRelationships.{{id}}"
                        data-actor-id="{{id}}"
                        class="vendor-relation-select">
                    {{#each ../vendorRelationOptions}}
                    <option value="{{level}}"
                        {{#if (eq level ../relationLevel)}}selected{{/if}}>
                        {{label}}
                    </option>
                    {{/each}}
                </select>
            </div>
            <div class="vr-col-rel">
                <span class="vendor-relation-effect {{effectClass}}"
                      data-actor-id="{{id}}">{{relationEffect}}</span>
            </div>
            {{#if ../vendorPresenceEnabled}}
            <div class="vr-col-presence">
                <span class="vendor-relation-effect {{presenceEffectClass}}">{{presenceEffect}}</span>
            </div>
            <div class="vr-col-total">
                <span class="vendor-relation-effect {{totalEffectClass}}">{{totalEffect}}</span>
            </div>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="notes warning">No users have a linked character assigned.
       Assign characters to users in the User Management panel.</p>
    {{/if}}
</div>
