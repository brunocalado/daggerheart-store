{{! Vendor Identity }}
<div class="config-section">
    <h3><i class="fas fa-id-card"></i> Vendor Identity</h3>
    <div class="vendor-identity-form">
        <label>Store Name</label>
        <input type="text" name="storeName" value="{{storeName}}">
        <span class="field-hint">Title of the main store window.</span>

        <label>Vendor Name <span class="optional">(optional)</span></label>
        <input type="text" name="vendorName" value="{{vendorName}}"
               placeholder="e.g. Garrick the Blacksmith">
        <span class="field-hint">NPC name shown in the store header.</span>

        <label>Vendor Description <span class="optional">(optional)</span></label>
        <textarea name="vendorDescription" class="vendor-description-field"
                  placeholder="Brief description of this vendor...">{{vendorDescription}}</textarea>
        <span class="field-hint">Flavor text shown below the vendor name.</span>
    </div>
</div>

<hr>

{{! Character Relationships }}
<div class="config-section">
    <h3><i class="fas fa-users"></i> Character Relationships</h3>
    {{#if linkedActors}}
    <p class="notes">Only characters linked to a user account are listed.
       Relationship is stored per actor and persists across user reassignments.</p>
    <div class="vendor-relations-list">
        {{#each linkedActors}}
        <div class="vendor-relation-row">
            <img class="vendor-actor-icon" src="{{img}}" title="{{name}}">
            <span class="vendor-actor-name">{{name}}</span>
            <select name="vendorRelationships.{{id}}"
                    data-actor-id="{{id}}"
                    class="vendor-relation-select">
                {{#each ../vendorRelationOptions}}
                <option value="{{level}}"
                    {{#if (eq level ../relationLevel)}}selected{{/if}}>
                    {{label}}
                </option>
                {{/each}}
            </select>
            <span class="vendor-relation-effect {{effectClass}}"
                  data-actor-id="{{id}}">{{relationEffect}}</span>
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="notes warning">No users have a linked character assigned.
       Assign characters to users in the User Management panel.</p>
    {{/if}}
</div>

<hr>

{{! Relationship Modifiers }}
<div class="config-section">
    <h3><i class="fas fa-heart"></i> Relationship Modifiers</h3>
    <p class="notes">Define the price modifier (%) for each relationship level.
       Hostile/Distrustful increase prices; Friendly/Allied decrease them.</p>

    <table class="vendor-relation-table">
        <thead>
            <tr>
                <th>Level</th>
                <th>Label</th>
                <th>Price Effect</th>
                <th>Modifier %</th>
            </tr>
        </thead>
        <tbody>
            {{#each vendorRelationLevelsArray}}
            <tr class="{{#if (eq direction "up")}}modifier-row-up{{else if (eq direction "down")}}modifier-row-down{{else}}modifier-row-neutral{{/if}}">
                <td class="modifier-level-cell">
                    <span class="modifier-level-badge level-{{direction}}">{{level}}</span>
                </td>
                <td class="modifier-label-cell">{{label}}</td>
                <td class="modifier-effect-cell">
                    {{#if (eq direction "up")}}
                        <span class="effect-up"><i class="fas fa-arrow-up"></i> Higher</span>
                    {{else if (eq direction "down")}}
                        <span class="effect-down"><i class="fas fa-arrow-down"></i> Lower</span>
                    {{else}}
                        <span class="effect-neutral">—</span>
                    {{/if}}
                </td>
                <td class="modifier-input-cell">
                    {{#if (eq level 0)}}
                        <span class="modifier-fixed">0% (fixed)</span>
                        <input type="hidden" name="vendorRelationLevels.0" value="0">
                    {{else}}
                        <div class="modifier-input-wrapper">
                            <input type="number"
                                   class="vendor-relation-pct-input"
                                   name="vendorRelationLevels.{{level}}"
                                   data-level="{{level}}"
                                   value="{{pct}}"
                                   min="0" max="100" step="5">
                            <span class="modifier-pct-suffix">%</span>
                        </div>
                    {{/if}}
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>